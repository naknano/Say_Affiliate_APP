
<div class="tp-login-area pre-header pt-200 pb-140 p-relative z-index-1 fix">
   <div class="container container-1230 containers">
      <div class="row justify-content-center">
         <div class="col-xl-6 col-lg-8">
            <div class="tp-login-wrapper">
               <div class="tp-login-top text-center mb-30">
                  <h3 class="tp-login-title">Forgot your password?</h3>
                  <p>Enter your email and we'll send you a link to reset your password.</p>
               </div>
               <div class="tp-login-option">
                  <div class="tp-login-input-wrapper">
                     <div class="tp-login-input-box">
                        <div class="tp-login-input-title">
                           <label for="email">Your Email</label>
                        </div>
                        <div class="tp-login-input">
                           <input class="email-forgot" id="email" type="email" placeholder="aleric@mail.com">
                        </div>
                     </div>
                  </div>
                  <div class="tp-login-bottom mt-30">
                     <button class="tp-login-btn w-100 btn-forgot">Send reset link</button>
                  </div>
                  <div class="tp-login-top text-center mt-20">
                     <p>Remember your password? <span><a asp-action="Login" asp-controller="Home">Back to login</a></span></p>
                  </div>
               </div>
            </div>
         </div>
      </div>
   </div>
</div>

@section Scripts {
   <script>
      $(document).ready(function () {
         $('.btn-forgot').click(function () {
            let $btn = $(this);
            let Email = $('.email-forgot').val();

            if (!Email || Email.trim() === '') {
               Swal.fire({ title: 'Warning!', text: 'Please enter your email.', icon: 'warning', confirmButtonText: 'Close' });
               return;
            }

            // Show a spinner and prevent double submits while the request is in flight.
            let originalHtml = $btn.html();
            $btn.prop('disabled', true).html('<span class="spinner-border spinner-border-sm me-2" role="status" aria-hidden="true"></span>Sending...');

            $.ajax({
               url: window.APP_CONFIG.BASE_URL + window.APP_CONFIG.PATH_FORGOT_PASSWORD,
               type: 'POST',
               contentType: 'application/json',
               data: JSON.stringify({ Email }),
               success: function (res) {
                  if (res.responseCode == 200) {
                     Swal.fire({ title: 'Check your email!', text: res.responseMessage, icon: 'success', confirmButtonText: 'OK' });
                  } else {
                     Swal.fire({ title: 'Warning!', text: res.responseMessage, icon: 'warning', confirmButtonText: 'Close' });
                  }
               },
               error: function (error) {
                  Swal.fire({ title: 'Error!', text: error.message, icon: 'error', confirmButtonText: 'Close' });
               },
               complete: function () {
                  $btn.prop('disabled', false).html(originalHtml);
               }
            });
         });
      });
   </script>
}
