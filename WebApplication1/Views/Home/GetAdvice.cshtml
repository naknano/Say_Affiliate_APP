                    </div>
                </div>
            </div>
            <div class="col-lg-6" data-aos="fade-left">
                <div class="adv-step-img">
                    <div class="adv-step-img-icon"><i class="fa-solid fa-wallet"></i></div>
                    <div class="adv-step-img-label">Your cashback, automated.</div>
                    <div style="display:flex;gap:30px;margin-top:10px;">
                        <div style="text-align:center;">
                            <div style="font-size:28px;font-weight:900;color:#fff;">$8.50</div>
                            <div style="font-size:12px;color:rgba(255,255,255,.5);">per lot max</div>
                        </div>
                        <div style="width:1px;background:rgba(255,255,255,.1);"></div>
                        <div style="text-align:center;">
                            <div style="font-size:28px;font-weight:900;color:#fff;">Weekly</div>
                            <div style="font-size:12px;color:rgba(255,255,255,.5);">payouts</div>
                        </div>
                        <div style="width:1px;background:rgba(255,255,255,.1);"></div>
                        <div style="text-align:center;">
                            <div style="font-size:28px;font-weight:900;color:#fff;">Free</div>
                            <div style="font-size:12px;color:rgba(255,255,255,.5);">to join</div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

