@{
    ViewData["Title"] = "Pip Value Calculator";

    var instruments = new[]
    {
        new { Name = "EUR/USD", PipSize = 0.0001, ContractSize = 100000 },
        new { Name = "GBP/USD", PipSize = 0.0001, ContractSize = 100000 },
        new { Name = "USD/JPY", PipSize = 0.01,   ContractSize = 100000 },
        new { Name = "USD/CHF", PipSize = 0.0001, ContractSize = 100000 },
        new { Name = "AUD/USD", PipSize = 0.0001, ContractSize = 100000 },
        new { Name = "USD/CAD", PipSize = 0.0001, ContractSize = 100000 },
        new { Name = "NZD/USD", PipSize = 0.0001, ContractSize = 100000 },
        new { Name = "EUR/GBP", PipSize = 0.0001, ContractSize = 100000 },
        new { Name = "EUR/JPY", PipSize = 0.01,   ContractSize = 100000 },
        new { Name = "GBP/JPY", PipSize = 0.01,   ContractSize = 100000 },
        new { Name = "XAU/USD", PipSize = 0.01,   ContractSize = 100   },
        new { Name = "XAG/USD", PipSize = 0.001,  ContractSize = 5000  },
    };

    var currencies = new[] { "US Dollar", "Euro", "British Pound", "Japanese Yen", "Swiss Franc", "Australian Dollar", "Canadian Dollar", "New Zealand Dollar" };
}

<!-- pip calc hero -->
<div class="sa-calchero">
   <span class="sa-calchero__glow sa-calchero__glow--one"></span>
   <span class="sa-calchero__glow sa-calchero__glow--two"></span>
   <span class="sa-calchero__grid"></span>
   <svg class="sa-calchero__spark" viewBox="0 0 500 120" preserveAspectRatio="none" aria-hidden="true">
      <defs>
         <linearGradient id="fxhLinePip" x1="0" y1="0" x2="1" y2="0">
            <stop offset="0%" stop-color="#06d6a0"/>
            <stop offset="100%" stop-color="#ffd166"/>
         </linearGradient>
      </defs>
      <path d="M0,90 L60,90 90,50 120,100 160,60 200,105 240,35 280,75 320,50 360,92 400,55 440,78 500,60"
            fill="none" stroke="url(#fxhLinePip)" stroke-width="2.5" stroke-linejoin="round"/>
   </svg>
   <div class="container containers">
      <div class="row justify-content-center">
         <div class="col-lg-9 text-center">
            <span class="sa-calchero__badge"><i class="fa-solid fa-percent"></i> Pip Value Calculator</span>
            <h1 class="sa-calchero__title">Pip <span class="sa-calchero__highlight">Value</span> Calculator</h1>
            <div class="sa-calchero__crumb">
               <a asp-controller="Home" asp-action="Index">Home</a>
               <i class="fa-solid fa-angle-right"></i>
               <span>Pip Value Calculator</span>
            </div>
            <p class="sa-calchero__intro">
               Know exactly what each pip is worth in your deposit currency before you place a trade.
            </p>
            <div class="sa-calchero__trust">
               <span><i class="fa-solid fa-bolt"></i> Instant results</span>
               <span><i class="fa-solid fa-coins"></i> Any currency pair</span>
               <span><i class="fa-solid fa-shield-halved"></i> Trade with precision</span>
            </div>
         </div>
      </div>
   </div>
</div>
<!-- pip calc hero end -->

<style>
   .sa-calchero {
      position: relative;
      overflow: hidden;
      padding: 160px 0 80px;
      background: radial-gradient(120% 120% at 80% 0%, #0e1330 0%, #070912 55%, #05060d 100%);
      color: #fff;
   }
   .sa-calchero__glow { position: absolute; border-radius: 50%; filter: blur(90px); pointer-events: none; z-index: 0; }
   .sa-calchero__glow--one { width: 460px; height: 460px; top: -160px; left: -120px; background: rgba(108, 92, 231, .35); }
   .sa-calchero__glow--two { width: 460px; height: 460px; bottom: -200px; right: -120px; background: rgba(6, 214, 160, .3); }
   .sa-calchero__grid {
      position: absolute; inset: 0; z-index: 0; pointer-events: none; opacity: .5;
      background-image:
         linear-gradient(rgba(255,255,255,.04) 1px, transparent 1px),
         linear-gradient(90deg, rgba(255,255,255,.04) 1px, transparent 1px);
      background-size: 46px 46px;
      -webkit-mask-image: radial-gradient(120% 90% at 50% 0%, #000 30%, transparent 75%);
      mask-image: radial-gradient(120% 90% at 50% 0%, #000 30%, transparent 75%);
   }
   .sa-calchero__spark {
      position: absolute; left: 0; right: 0; bottom: 0; width: 100%; height: 140px; z-index: 0;
      opacity: .45; pointer-events: none;
   }
   .sa-calchero__spark path { stroke-dasharray: 1400; stroke-dashoffset: 1400; animation: saSparkDraw 3s ease forwards .3s; }
   @@keyframes saSparkDraw { to { stroke-dashoffset: 0; } }
   .sa-calchero .container { position: relative; z-index: 1; }

   .sa-calchero__badge {
      display: inline-flex; align-items: center; gap: 8px;
      padding: 8px 18px; margin-bottom: 22px;
      font-size: 14px; font-weight: 600; border-radius: 999px;
      color: #06d6a0; background: rgba(6, 214, 160, .12); border: 1px solid rgba(6, 214, 160, .3);
   }
   .sa-calchero__title { font-size: 56px; line-height: 1.08; font-weight: 800; margin: 0 0 16px; color: #fff; }
   .sa-calchero__highlight {
      background: linear-gradient(90deg, #ffd166, #06d6a0);
      -webkit-background-clip: text; background-clip: text; -webkit-text-fill-color: transparent;
   }
   .sa-calchero__crumb { display: inline-flex; align-items: center; gap: 10px; font-size: 14px; margin-bottom: 20px; }
   .sa-calchero__crumb a { color: rgba(255, 255, 255, .7); text-decoration: none; transition: color .2s ease; }
   .sa-calchero__crumb a:hover { color: #06d6a0; }
   .sa-calchero__crumb i { font-size: 11px; color: rgba(255, 255, 255, .4); }
   .sa-calchero__crumb span { color: #ffd166; font-weight: 600; }
   .sa-calchero__intro { font-size: 17px; line-height: 1.7; color: rgba(255, 255, 255, .7); margin: 0 auto 28px; max-width: 640px; }

   .sa-calchero__trust { display: inline-flex; flex-wrap: wrap; justify-content: center; gap: 14px; }
   .sa-calchero__trust span {
      display: inline-flex; align-items: center; gap: 8px;
      padding: 10px 18px; border-radius: 12px; font-size: 14px; font-weight: 500;
      color: rgba(255, 255, 255, .85);
      background: rgba(255, 255, 255, .04); border: 1px solid rgba(255, 255, 255, .08);
   }
   .sa-calchero__trust i { color: #ffd166; }

   @@media (max-width: 991px) {
      .sa-calchero { padding: 130px 0 60px; }
      .sa-calchero__title { font-size: 38px; }
   }
</style>

<!-- pip calc body -->
<div class="fx-calc pre-header pt-80 pb-120">
    <div class="container container-1230">
        <div class="fx-calc-card">
            <div class="row g-0">

                <!-- inputs -->
                <div class="col-lg-6">
                    <div class="fx-calc-form">
                        <h3 class="fx-calc-form-title">Your trade details</h3>

                        <div class="fx-calc-field">
                            <label for="pipPairs">Instrument</label>
                            <div class="fx-calc-select">
                                <i class="fa-solid fa-chart-line"></i>
                                <select id="pipPairs">
                                    @foreach (var ins in instruments)
                                    {
                                        <option value="@ins.PipSize.ToString(System.Globalization.CultureInfo.InvariantCulture)"
                                                data-contract="@ins.ContractSize"
                                                data-name="@ins.Name">
                                            @ins.Name
                                        </option>
                                    }
                                </select>
                            </div>
                        </div>

                        <div class="fx-calc-field">
                            <label for="pipPips">Pips</label>
                            <div class="fx-calc-select">
                                <i class="fa-solid fa-hashtag"></i>
                                <input type="number" id="pipPips" class="fx-calc-input" value="1" min="0.1" step="0.1" />
                            </div>
                        </div>

                        <div class="fx-calc-field">
                            <label for="pipLots">Lots (trade size)</label>
                            <div class="fx-calc-select">
                                <i class="fa-solid fa-layer-group"></i>
                                <input type="number" id="pipLots" class="fx-calc-input" value="1" min="0.01" step="0.01" />
                            </div>
                        </div>

                        <div class="fx-calc-field">
                            <label for="pipDepositCcy">Deposit currency</label>
                            <div class="fx-calc-select">
                                <i class="fa-solid fa-coins"></i>
                                <select id="pipDepositCcy">
                                    @foreach (var ccy in currencies)
                                    {
                                        <option>@ccy</option>
                                    }
                                </select>
                            </div>
                        </div>

                        <div class="fx-calc-field" id="pipSizeRow">
                            <label id="pipSizeLabel">EUR/USD 1 Pip Size</label>
                            <div class="fx-calc-select">
                                <i class="fa-solid fa-ruler"></i>
                                <input type="text" id="pipSizeDisplay" class="fx-calc-input" readonly />
                            </div>
                        </div>

                        <button type="button" class="fx-calc-btn" id="pipCalcBtn">
                            <i class="fa-solid fa-calculator"></i> Calculate
                        </button>
                    </div>
                </div>

                <!-- result -->
                <div class="col-lg-6">
                    <div class="fx-calc-result">
                        <span class="fx-calc-result-shape"></span>
                        <div class="fx-calc-result-top">
                            <span class="fx-calc-result-label">Pip value</span>
                            <span class="fx-calc-result-period" id="pipCcyLabel">USD</span>
                        </div>
                        <div class="fx-calc-result-hero" id="pipResult">$0.00</div>

                        <div class="fx-calc-result-grid">
                            <div class="fx-calc-result-item">
                                <span class="fx-calc-result-k">Per pip</span>
                                <span class="fx-calc-result-v" id="pipPerPip">$0.00</span>
                            </div>
                            <div class="fx-calc-result-item">
                                <span class="fx-calc-result-k">Total pips value</span>
                                <span class="fx-calc-result-v" id="pipTotal">$0.00</span>
                            </div>
                            <div class="fx-calc-result-item">
                                <span class="fx-calc-result-k">Lot size</span>
                                <span class="fx-calc-result-v" id="pipLotSize">100,000</span>
                            </div>
                            <div class="fx-calc-result-item">
                                <span class="fx-calc-result-k">Pip size</span>
                                <span class="fx-calc-result-v" id="pipSizeVal">0.0001</span>
                            </div>
                        </div>

                        <a asp-controller="Home" asp-action="Register" class="fx-calc-cta">
                            Start trading with cashback <i class="fa-solid fa-arrow-right-long"></i>
                        </a>
                        <p class="fx-calc-result-foot">Free to join &middot; paid weekly &middot; no hidden fees</p>
                    </div>
                </div>

            </div>
        </div>

        <!-- info cards -->
        <div class="row mt-50">
            <div class="col-md-4 mb-20">
                <div class="fx-calc-info">
                    <span class="fx-calc-info-icon"><i class="fa-solid fa-sliders"></i></span>
                    <h5>1. Select your pair</h5>
                    <p>Choose the currency pair or instrument you are trading and enter your lot size.</p>
                </div>
            </div>
            <div class="col-md-4 mb-20">
                <div class="fx-calc-info">
                    <span class="fx-calc-info-icon"><i class="fa-solid fa-bolt"></i></span>
                    <h5>2. Hit Calculate</h5>
                    <p>See the exact pip value in your deposit currency instantly, no guesswork needed.</p>
                </div>
            </div>
            <div class="col-md-4 mb-20">
                <div class="fx-calc-info">
                    <span class="fx-calc-info-icon"><i class="fa-solid fa-shield-halved"></i></span>
                    <h5>3. Size your risk</h5>
                    <p>Use the pip value to set your stop-loss and position size with confidence.</p>
                </div>
            </div>
        </div>
    </div>
</div>
<!-- pip calc body end -->

@section Scripts {
<script>
(function () {
    var pairsEl   = document.getElementById('pipPairs');
    var pipsEl    = document.getElementById('pipPips');
    var lotsEl    = document.getElementById('pipLots');
    var ccyEl     = document.getElementById('pipDepositCcy');
    var btnEl     = document.getElementById('pipCalcBtn');
    var sizeDisp  = document.getElementById('pipSizeDisplay');
    var sizeLbl   = document.getElementById('pipSizeLabel');
    if (!pairsEl) return;

    var fmt = function (n) {
        return '$' + n.toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
    };

    function updatePipSize() {
        var opt = pairsEl.options[pairsEl.selectedIndex];
        var pipSize = parseFloat(opt.value) || 0.0001;
        var name    = opt.getAttribute('data-name') || '';
        sizeDisp.value = pipSize;
        sizeLbl.textContent = name + ' 1 Pip Size';
        document.getElementById('pipSizeVal').textContent = pipSize;
        var contract = parseInt(opt.getAttribute('data-contract'), 10) || 100000;
        document.getElementById('pipLotSize').textContent = contract.toLocaleString('en-US');
    }

    function calc() {
        var opt      = pairsEl.options[pairsEl.selectedIndex];
        var pipSize  = parseFloat(opt.value) || 0.0001;
        var contract = parseInt(opt.getAttribute('data-contract'), 10) || 100000;
        var pips     = parseFloat(pipsEl.value) || 0;
        var lots     = parseFloat(lotsEl.value) || 0;

        var perPip = pipSize * contract * lots;
        var total  = perPip * pips;

        var ccy = ccyEl.value || 'US Dollar';
        var symbol = ccy === 'US Dollar' ? '$' : ccy === 'Euro' ? '€' : ccy === 'British Pound' ? '£' : ccy === 'Japanese Yen' ? '¥' : '$';
        var fmtCcy = function (n) {
            return symbol + n.toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
        };

        document.getElementById('pipPerPip').textContent = fmtCcy(perPip);
        document.getElementById('pipTotal').textContent  = fmtCcy(total);
        document.getElementById('pipResult').textContent = fmtCcy(total);
        document.getElementById('pipCcyLabel').textContent = ccy;
    }

    pairsEl.addEventListener('change', function () { updatePipSize(); calc(); });
    btnEl.addEventListener('click', calc);
    pipsEl.addEventListener('input', calc);
    lotsEl.addEventListener('input', calc);
    ccyEl.addEventListener('change', calc);

    updatePipSize();
    calc();
})();
</script>
}
