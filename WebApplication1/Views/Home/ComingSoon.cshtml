<!-- coming soon area start -->
<div class="cs-modern">
    <span class="cs-blob cs-blob-1"></span>
    <span class="cs-blob cs-blob-2"></span>
    <span class="cs-blob cs-blob-3"></span>
    <span class="cs-ring cs-ring-1"></span>
    <span class="cs-ring cs-ring-2"></span>

    <div class="container">
        <div class="cs-inner text-center">

            <div class="cs-icon">
                <i class="fa-solid fa-rocket"></i>
            </div>

            <span class="cs-badge"><i class="fa-solid fa-wand-magic-sparkles"></i> Coming Soon</span>

            <h1 class="cs-title">Something <span>awesome</span> is on the way</h1>

            <p class="cs-desc">
                We're working hard on this feature to make your trading experience even better.
                Stay tuned — it will be worth the wait.
            </p>

            <div class="cs-progress">
                <div class="cs-progress-head">
                    <span>Development progress</span>
                    <span class="cs-progress-percent">75%</span>
                </div>
                <div class="cs-progress-bar">
                    <span class="cs-progress-fill"></span>
                </div>
            </div>

            <div class="cs-features">
                <span class="cs-feature"><i class="fa-solid fa-copy"></i> Copy Trade</span>
                <span class="cs-feature"><i class="fa-solid fa-sack-dollar"></i> Fund Management</span>
                <span class="cs-feature"><i class="fa-solid fa-toolbox"></i> Forex Tools</span>
            </div>

            <div class="cs-actions">
                <a asp-controller="Home" asp-action="Index" class="broker-btn broker-btn-ghost"><i class="fa-solid fa-house"></i> Back to Home</a>
                <a asp-controller="Home" asp-action="Broker" class="broker-btn broker-btn-solid">Explore Brokers <i class="fa-solid fa-arrow-right-long"></i></a>
            </div>

            <p class="cs-contact">
                Want to be notified when it launches?
                <a asp-controller="Home" asp-action="ContactUs">Contact us</a> and we'll keep you posted.
            </p>

        </div>
    </div>
</div>
<!-- coming soon area end -->
