<!-- Number of created tp-counter-area-start -->
<div class="tp-counter-area home-counter pb-30" style="background-color: #fdfdff;">
    <div class="container">
        <div class="row">
            <div class="col-lg-12">
                <div class="tp-counter-wrap">
                    <div class="tp-counter-wrap-box bounce_animation">
                        <div class="tp-counter-item bounce__anim bounce__anim">
                            <h3 class="fw-500 fs-70 fs-md-50 text-uppercase"><span data-purecounter-duration="1" data-purecounter-end="900" class="purecounter">0</span>+</h3>
                            <span class="fw-500 fs-18 fs-md-15 lh-22 tp-text-grey-1">Account Created</span>
                        </div>
                        <div class="tp-counter-item bounce__anim">
                            <h3 class="fw-500 fs-70 fs-md-50 text-uppercase"><span data-purecounter-duration="1" data-purecounter-end="100" class="purecounter">0</span>+</h3>
                            <span class="fw-500 fs-18 fs-md-15 lh-22 tp-text-grey-1">Broker / Exchanges</span>
                        </div>
                        <div class="tp-counter-item bounce__anim">
                            <h3 class="fw-500 fs-70 fs-md-50 text-uppercase"><span data-purecounter-duration="1" data-purecounter-end="600" class="purecounter">0</span>K</h3>
                            <span class="fw-500 fs-18 fs-md-15 lh-22 tp-text-grey-1">Paid Cashback</span>
                        </div>
                        <div class="tp-counter-item bounce__anim">
                            <h3 class="fw-500 fs-70 fs-md-50 text-uppercase"><span data-purecounter-duration="1" data-purecounter-end="24" class="purecounter">0</span>/7</h3>
                            <span class="fw-500 fs-18 fs-md-15 lh-22 tp-text-grey-1">Live assistance</span>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
<!-- tp-counter-area-end -->


<!-- trusted brokers marquee start -->
@{
    var trustedRow1 = new[]
    {
        "1.Oanda.png", "10.FP-Markets.png", "3.BlackBull.png", "42.IC-Markets.png",
        "70.FxPro.png", "31.Tickmill.png", "36.Vantage-FX.png", "2.ACY.png"
    };
    var trustedRow2 = new[]
    {
        "9.BlueBerry-Markets.png", "35.HYCM.png", "14.AXI.png", "12.ActivTrades.png",
        "13.ICM-Capital.png", "18.Axiory.png", "23.Skilling.png", "25.FusionMarkets.png"
    };
}
<div class="home-trusted pt-100 pb-100">
    <span class="home-trusted-glow"></span>
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-xl-7 col-lg-9">
                <div class="home-trusted-head text-center">
                    <span class="home-trusted-badge"><i class="fa-solid fa-handshake-angle"></i> Our Broker Partners</span>
                    <h4 class="home-trusted-title">Trusted across <span>70+</span> regulated brokers</h4>
                    <p class="home-trusted-desc">Earn cashback while trading with the world's most reputable, fully licensed forex brokers.</p>
                </div>
            </div>
        </div>
    </div>

    <div class="home-trusted-rows">
        <div class="home-trusted-marquee">
            <div class="home-trusted-track">
                @foreach (var logo in trustedRow1)
                {
                    <div class="home-trusted-logo"><img src="~/assets/img/Broker/@logo" alt="broker" loading="lazy"></div>
                }
                @foreach (var logo in trustedRow1)
                {
                    <div class="home-trusted-logo" aria-hidden="true"><img src="~/assets/img/Broker/@logo" alt="" loading="lazy"></div>
                }
            </div>
        </div>
        <div class="home-trusted-marquee">
            <div class="home-trusted-track home-trusted-track--reverse">
                @foreach (var logo in trustedRow2)
                {
                    <div class="home-trusted-logo"><img src="~/assets/img/Broker/@logo" alt="broker" loading="lazy"></div>
                }
                @foreach (var logo in trustedRow2)
                {
                    <div class="home-trusted-logo" aria-hidden="true"><img src="~/assets/img/Broker/@logo" alt="" loading="lazy"></div>
                }
            </div>
        </div>
    </div>
    
    <div class="container">
        <div class="text-center mt-45">
            <a asp-controller="Home" asp-action="Broker" class="broker-btn broker-btn-solid">Browse all brokers <i class="fa-solid fa-arrow-right-long"></i></a>
        </div>
    </div>
</div>
<!-- trusted brokers marquee end -->


