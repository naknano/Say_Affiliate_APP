@model WebApplication1.Data.DTO.Broker.BrokerListPageDto
@{
    // Server-side paged broker list — only the current page (10 items) is fetched & rendered.
    var vm = Model ?? new WebApplication1.Data.DTO.Broker.BrokerListPageDto();
    var items = vm.Items;
}

<style>
   .broker-pagination { display: flex; flex-wrap: wrap; justify-content: center; gap: 8px; margin-top: 30px; }
   .broker-page-btn {
      min-width: 42px; height: 42px; padding: 0 12px;
      display: inline-flex; align-items: center; justify-content: center;
      border: 1.5px solid #e2e8f0; background: #fff; color: #16202e;
      font-size: 14px; font-weight: 700; border-radius: 10px; cursor: pointer;
      text-decoration: none; transition: all .18s ease;
   }
   .broker-page-btn:hover:not(.disabled) { border-color: #06b88a; color: #06b88a; background: #eefaf5; }
   .broker-page-btn.active { background: linear-gradient(90deg,#ffd166,#06d6a0); border-color: transparent; color: #05060d; box-shadow: 0 8px 18px -8px rgba(6,214,160,.8); }
   .broker-page-btn.disabled { opacity: .45; pointer-events: none; }
</style>

<!-- tp-portfolio-area-start -->
<div class="sa-bkhero">
   <span class="sa-bkhero__glow sa-bkhero__glow--one"></span>
   <span class="sa-bkhero__glow sa-bkhero__glow--two"></span>
   <div class="container containers">
      <div class="row align-items-end">
         <div class="col-lg-7">
            <span class="sa-bkhero__badge"><i class="fa-solid fa-handshake-angle"></i> Trusted broker partners</span>
            <h1 class="sa-bkhero__title">Forex Rebate <span class="sa-bkhero__highlight">Brokers List</span></h1>
         </div>
         <div class="col-lg-5">
            <p class="sa-bkhero__lead">
               Partner with top forex brokers for better trading. Compare compliance, pricing,
               and platforms like MT4/MT5. Need a broker?
               <a asp-controller="Home" asp-action="Register">Let us know</a> &mdash; we're always expanding.
            </p>
         </div>
      </div>
      <div class="sa-bkhero__stats">
         <div class="sa-bkhero__stat"><i class="fa-solid fa-building-columns"></i> <strong>@vm.AllCount</strong> brokers listed</div>
         <div class="sa-bkhero__stat"><i class="fa-solid fa-shield-halved"></i> Regulated partners</div>
         <div class="sa-bkhero__stat"><i class="fa-solid fa-sack-dollar"></i> Up to $8.50 / lot</div>
         <div class="sa-bkhero__stat"><i class="fa-solid fa-calendar-check"></i> Paid weekly</div>
      </div>
      <div class="row">
         <div class="col-12">
            <div class="broker-tab-wrap sa-bkhero__tabs mt-40">
               <nav>
                  <div class="nav broker-tabs" id="nav-tab" role="tablist">
                     <a class="nav-link @(vm.Tab == "all" ? "active" : "")" asp-controller="Home" asp-action="Broker" asp-route-tab="all" asp-route-page="1"><i class="fa-solid fa-list"></i> All Brokers <span class="broker-tab-count">@vm.AllCount</span></a>
                     <a class="nav-link @(vm.Tab == "top" ? "active" : "")" asp-controller="Home" asp-action="Broker" asp-route-tab="top" asp-route-page="1"><i class="fa-solid fa-crown"></i> Top Brokers <span class="broker-tab-count">@vm.TopCount</span></a>
                  </div>
               </nav>
            </div>
         </div>
      </div>
   </div>
</div>
<!-- tp-portfolio-area-end -->

<style>
   .sa-bkhero {
      position: relative;
      overflow: hidden;
      padding: 160px 0 60px;
      background: radial-gradient(120% 120% at 80% 0%, #0e1330 0%, #070912 55%, #05060d 100%);
      color: #fff;
   }
   .sa-bkhero__glow { position: absolute; border-radius: 50%; filter: blur(90px); pointer-events: none; z-index: 0; }
   .sa-bkhero__glow--one { width: 460px; height: 460px; top: -160px; left: -120px; background: rgba(108, 92, 231, .35); }
   .sa-bkhero__glow--two { width: 460px; height: 460px; bottom: -200px; right: -120px; background: rgba(6, 214, 160, .3); }
   .sa-bkhero .container { position: relative; z-index: 1; }

   .sa-bkhero__badge {
      display: inline-flex; align-items: center; gap: 8px;
      padding: 8px 18px; margin-bottom: 22px;
      font-size: 14px; font-weight: 600; border-radius: 999px;
      color: #06d6a0; background: rgba(6, 214, 160, .12); border: 1px solid rgba(6, 214, 160, .3);
   }
   .sa-bkhero__title { font-size: 60px; line-height: 1.05; font-weight: 800; margin: 0; color: #fff; }
   .sa-bkhero__highlight {
      background: linear-gradient(90deg, #ffd166, #06d6a0);
      -webkit-background-clip: text; background-clip: text; -webkit-text-fill-color: transparent;
   }
   .sa-bkhero__lead { font-size: 17px; line-height: 1.7; color: rgba(255, 255, 255, .7); margin: 0 0 6px; }
   .sa-bkhero__lead a { color: #06d6a0; font-weight: 600; }

   .sa-bkhero__stats { display: flex; flex-wrap: wrap; gap: 14px; margin-top: 40px; }
   .sa-bkhero__stat {
      display: inline-flex; align-items: center; gap: 8px;
      padding: 10px 18px; border-radius: 12px; font-size: 14px; font-weight: 500;
      color: rgba(255, 255, 255, .85);
      background: rgba(255, 255, 255, .04); border: 1px solid rgba(255, 255, 255, .08);
   }
   .sa-bkhero__stat i { color: #ffd166; }
   .sa-bkhero__stat strong { color: #fff; font-weight: 800; }

   /* tabs restyled for dark hero */
   .sa-bkhero__tabs .broker-tabs { gap: 12px; border: none; }
   .sa-bkhero__tabs .nav-link {
      display: inline-flex; align-items: center; gap: 8px;
      padding: 12px 22px; border-radius: 12px; font-weight: 700; font-size: 15px;
      color: rgba(255, 255, 255, .75);
      background: rgba(255, 255, 255, .05); border: 1px solid rgba(255, 255, 255, .1) !important;
      transition: all .22s ease;
   }
   .sa-bkhero__tabs .nav-link:hover { color: #fff; border-color: rgba(6, 214, 160, .4) !important; }
   .sa-bkhero__tabs .nav-link.active {
      color: #05060d;
      background: linear-gradient(90deg, #ffd166, #06d6a0);
      border-color: transparent !important;
      box-shadow: 0 10px 24px -8px rgba(6, 214, 160, .7);
   }
   .sa-bkhero__tabs .broker-tab-count {
      display: inline-flex; align-items: center; justify-content: center;
      min-width: 24px; height: 22px; padding: 0 7px; border-radius: 999px;
      font-size: 12px; font-weight: 800;
      background: rgba(0, 0, 0, .18); color: inherit;
   }
   .sa-bkhero__tabs .nav-link:not(.active) .broker-tab-count { background: rgba(255, 255, 255, .12); }

   @@media (max-width: 991px) {
      .sa-bkhero { padding: 130px 0 50px; }
      .sa-bkhero__title { font-size: 40px; }
      .sa-bkhero__lead { margin-top: 20px; }
   }
</style>

<!-- broker list start -->
<div class="tp-portfolio-inner-ptb pre-header pb-100 broker-modern">
   <div class="container container-1600 containers">
      <div class="tp-portfolio-tab-content-wrap">
         @if (items.Count == 0)
         {
            <div class="text-center" style="padding:70px 16px;color:#7a8699;">
               <i class="fa-solid fa-building-columns" style="font-size:40px;opacity:.3;"></i>
               <p style="margin:14px 0 0;font-weight:600;">No brokers to show</p>
               <span style="font-size:14px;">Please check back soon.</span>
            </div>
         }
         else
         {
            <div class="row">
               @foreach (var b in items)
               {
                  <div class="col-xxl-3 col-xl-4 col-md-6 mb-30">
                     <partial name="_BrokerCard" model="b" />
                  </div>
               }
            </div>

            @if (vm.TotalPages > 1)
            {
               <div class="broker-pagination">
                  <a class="broker-page-btn @(vm.Page <= 1 ? "disabled" : "")"
                     asp-controller="Home" asp-action="Broker" asp-route-tab="@vm.Tab" asp-route-page="@(vm.Page - 1)"
                     aria-label="Previous"><i class="fa-solid fa-chevron-left"></i></a>

                  @for (var p = 1; p <= vm.TotalPages; p++)
                  {
                     <a class="broker-page-btn @(p == vm.Page ? "active" : "")"
                        asp-controller="Home" asp-action="Broker" asp-route-tab="@vm.Tab" asp-route-page="@p">@p</a>
                  }

                  <a class="broker-page-btn @(vm.Page >= vm.TotalPages ? "disabled" : "")"
                     asp-controller="Home" asp-action="Broker" asp-route-tab="@vm.Tab" asp-route-page="@(vm.Page + 1)"
                     aria-label="Next"><i class="fa-solid fa-chevron-right"></i></a>
               </div>

               <p class="text-center" style="margin-top:14px;color:#9aa6b8;font-size:13px;">
                  Showing @((vm.Page - 1) * vm.PageSize + 1)–@(Math.Min(vm.Page * vm.PageSize, vm.TotalItems)) of @vm.TotalItems brokers
               </p>
            }
         }
      </div>
   </div>
</div>
<!-- broker list end -->


