
<div class="tp-login-area pre-header pt-200 pb-140 p-relative z-index-1 fix">
   <div class="container container-1230 containers">
      <div class="row justify-content-center">
         <div class="col-xl-6 col-lg-8">
            <div class="tp-login-wrapper">
               <div class="tp-login-top text-center mb-30">
                  <h3 class="tp-login-title">Reset your password</h3>
                  <p>Choose a new password for your account.</p>
               </div>
               <div class="tp-login-option">
                  <input type="hidden" class="reset-email" value="@ViewBag.Email" />
                  <input type="hidden" class="reset-token" value="@ViewBag.Token" />
                  <div class="tp-login-input-wrapper">
                     <div class="tp-login-input-box">
                        <div class="tp-login-input-title">
                           <label for="tp_password">New Password</label>
                        </div>
                        <div class="tp-login-input">
                           <input class="new-password" id="tp_password" type="password" placeholder="Min. 6 character">
                        </div>
                     </div>
                     <div class="tp-login-input-box">
                        <div class="tp-login-input-title">
                           <label for="tp_repassword">Confirm Password</label>
                        </div>
                        <div class="tp-login-input">
                           <input class="confirm-password" id="tp_repassword" type="password" placeholder="Min. 6 character">
                        </div>
                     </div>
                  </div>
                  <div class="tp-login-bottom mt-30">
                     <button class="tp-login-btn w-100 btn-reset">Reset password</button>
                  </div>
                  <div class="tp-login-top text-center mt-20">
                     <p>Remember your password? <span><a asp-action="Login" asp-controller="Home">Back to login</a></span></p>
                  </div>
               </div>
            </div>
         </div>
      </div>
   </div>
</div>

@section Scripts {
   <script>
      $(document).ready(function () {
         $('.btn-reset').click(function () {
            let Email = $('.reset-email').val();
            let Token = $('.reset-token').val();
            let NewPassword = $('.new-password').val();
            let ConfirmPassword = $('.confirm-password').val();

            if (!NewPassword || NewPassword.trim() === '') {
               Swal.fire({ title: 'Warning!', text: 'Please enter a new password.', icon: 'warning', confirmButtonText: 'Close' });
               return;
            }

            if (NewPassword.trim() !== ConfirmPassword.trim()) {
               Swal.fire({ title: 'Warning!', text: 'Password and Confirm Password must be the same!', icon: 'warning', confirmButtonText: 'Close' });
               return;
            }

            $.ajax({
               url: window.APP_CONFIG.BASE_URL + window.APP_CONFIG.PATH_RESET_PASSWORD,
               type: 'POST',
               contentType: 'application/json',
               data: JSON.stringify({ Email, Token, NewPassword }),
               success: function (res) {
                  if (res.responseCode == 200) {
                     Swal.fire({ title: 'Success!', text: res.responseMessage, icon: 'success', confirmButtonText: 'OK' })
                        .then(function () { window.location.href = '/Home/Login'; });
                  } else {
                     Swal.fire({ title: 'Warning!', text: res.responseMessage, icon: 'warning', confirmButtonText: 'Close' });
                  }
               },
               error: function (error) {
                  Swal.fire({ title: 'Error!', text: error.message, icon: 'error', confirmButtonText: 'Close' });
               }
            });
         });
      });
   </script>
}
