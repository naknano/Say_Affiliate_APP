
<style>
   .sag-auth {
      --sag-accent: #16b979;
      --sag-accent-2: #0e8f5e;
      min-height: 100vh;
      display: flex;
      align-items: center;
      justify-content: center;
      background:
         radial-gradient(1100px 500px at 12% -10%, rgba(22, 185, 121, .18), transparent 60%),
         radial-gradient(900px 500px at 100% 110%, rgba(14, 143, 94, .16), transparent 55%),
         #0b1220;
   }
   .sag-auth .sag-shell {
      width: 100%; max-width: 1040px; display: grid;
      grid-template-columns: 1.05fr .95fr; align-items: stretch; gap: 30px; padding: 24px;
   }
   .sag-auth .sag-visual {
      position: relative; overflow: hidden; border-radius: 24px; padding: 40px; color: #fff;
      display: flex; flex-direction: column; justify-content: space-between; min-height: 540px;
      background:
         radial-gradient(600px 240px at 90% 0%, rgba(22, 185, 121, .35), transparent 60%),
         linear-gradient(160deg, #10324a 0%, #0c2233 60%, #0a1a28 100%);
      border: 1px solid rgba(255, 255, 255, .08); box-shadow: 0 30px 70px rgba(0, 0, 0, .4);
   }
   .sag-auth .sag-visual h2 { font-size: 30px; font-weight: 700; line-height: 1.25; margin: 0 0 12px; color: #fff; position: relative; z-index: 2; }
   .sag-auth .sag-visual p { color: #a9c3d1; font-size: 15px; max-width: 340px; position: relative; z-index: 2; }
   .sag-auth .sag-lock {
      position: relative; z-index: 2; width: 96px; height: 96px; border-radius: 24px;
      display: flex; align-items: center; justify-content: center; color: #fff; margin-top: 24px;
      background: linear-gradient(135deg, var(--sag-accent), var(--sag-accent-2));
      box-shadow: 0 16px 34px rgba(22, 185, 121, .45); animation: sagPulse 3s ease-in-out infinite;
   }
   @@keyframes sagPulse {
      0%, 100% { transform: translateY(0); box-shadow: 0 16px 34px rgba(22, 185, 121, .45); }
      50% { transform: translateY(-8px); box-shadow: 0 26px 44px rgba(22, 185, 121, .6); }
   }
   .sag-auth .sag-ring { position: absolute; border-radius: 50%; border: 1px solid rgba(22, 185, 121, .25); z-index: 1; }
   .sag-auth .sag-ring.r1 { width: 260px; height: 260px; right: -60px; top: 40px; }
   .sag-auth .sag-ring.r2 { width: 400px; height: 400px; right: -120px; top: -20px; border-color: rgba(22, 185, 121, .12); }
   @@media (prefers-reduced-motion: reduce) { .sag-auth .sag-lock { animation: none; } }
   .sag-auth .sag-card {
      width: 100%; max-width: 460px; margin: auto; background: rgba(255, 255, 255, .96);
      border: 1px solid rgba(255, 255, 255, .5); border-radius: 22px; padding: 44px 40px;
      box-shadow: 0 30px 70px rgba(0, 0, 0, .35); backdrop-filter: blur(8px);
   }
   .sag-auth .sag-brand {
      width: 62px; height: 62px; margin: 0 auto 18px; border-radius: 16px;
      display: flex; align-items: center; justify-content: center; color: #fff;
      background: linear-gradient(135deg, var(--sag-accent), var(--sag-accent-2));
      box-shadow: 0 10px 24px rgba(22, 185, 121, .4);
   }
   .sag-auth .sag-title { font-size: 26px; font-weight: 700; text-align: center; margin-bottom: 6px; color: #0b1220; }
   .sag-auth .sag-sub { text-align: center; color: #6b7280; font-size: 14px; margin-bottom: 30px; }
   .sag-auth .sag-field { margin-bottom: 20px; }
   .sag-auth .sag-field label { display: block; font-size: 13px; font-weight: 600; color: #374151; margin-bottom: 8px; }
   .sag-auth .sag-input { position: relative; display: flex; align-items: center; }
   .sag-auth .sag-input .sag-icon { position: absolute; left: 16px; color: #9ca3af; display: flex; }
   .sag-auth .sag-input input {
      width: 100%; height: 52px; padding: 0 46px; border: 1.5px solid #e5e7eb; border-radius: 12px;
      font-size: 15px; color: #111827; background: #f9fafb; transition: border-color .2s, box-shadow .2s, background .2s;
   }
   .sag-auth .sag-input input::placeholder { color: #9ca3af; }
   .sag-auth .sag-input input:focus { outline: none; background: #fff; border-color: var(--sag-accent); box-shadow: 0 0 0 4px rgba(22, 185, 121, .15); }
   .sag-auth .btn-reset {
      width: 100%; height: 54px; border: none; border-radius: 12px; color: #fff;
      font-size: 16px; font-weight: 600; cursor: pointer; margin-top: 6px;
      display: flex; align-items: center; justify-content: center;
      background: linear-gradient(135deg, var(--sag-accent), var(--sag-accent-2));
      box-shadow: 0 12px 26px rgba(22, 185, 121, .38); transition: transform .15s ease, box-shadow .2s ease, opacity .2s;
   }
   .sag-auth .btn-reset:hover { transform: translateY(-2px); box-shadow: 0 16px 32px rgba(22, 185, 121, .5); }
   .sag-auth .btn-reset:active { transform: translateY(0); }
   .sag-auth .btn-reset:disabled { opacity: .7; cursor: not-allowed; transform: none; }
   .sag-auth .sag-back { text-align: center; margin-top: 22px; font-size: 14px; color: #6b7280; }
   .sag-auth .sag-back a { color: var(--sag-accent-2); font-weight: 600; }
   @@media (max-width: 991px) {
      .sag-auth .sag-shell { grid-template-columns: 1fr; max-width: 520px; }
      .sag-auth .sag-visual { display: none; }
   }
   @@media (max-width: 480px) { .sag-auth .sag-card { padding: 34px 24px; border-radius: 18px; } }
</style>

<div class="tp-login-area sag-auth pre-header p-relative z-index-1 fix">
   <div class="sag-shell">
      <div class="sag-visual">
         <span class="sag-ring r1"></span>
         <span class="sag-ring r2"></span>
         <div>
            <h2>One last step<br>to secure your account.</h2>
            <p>Choose a strong new password. Once saved, you’ll use it to log in from now on.</p>
         </div>
         <div class="sag-lock">
            <svg width="42" height="42" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
               <rect x="4" y="10" width="16" height="10" rx="2.5" stroke="currentColor" stroke-width="1.6"/>
               <path d="M8 10V7a4 4 0 018 0v3" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/>
               <path d="M9.5 15l1.6 1.6 3.4-3.4" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
         </div>
      </div>

      <div class="sag-card">
         <input type="hidden" class="reset-email" value="@ViewBag.Email" />
         <input type="hidden" class="reset-token" value="@ViewBag.Token" />
         <div class="sag-brand">
            <svg width="28" height="28" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
               <path d="M2 12l4-1 3-6 3 12 3-8 2 3h5" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
         </div>
         <h3 class="sag-title">Reset your password</h3>
         <p class="sag-sub">Choose a new password for your account.</p>

         <div class="tp-login-option">
            <div class="sag-field">
               <label for="tp_password">New Password</label>
               <div class="sag-input">
                  <input class="new-password" id="tp_password" type="password" placeholder="Min. 6 character">
                  <span class="sag-icon">
                     <svg width="18" height="18" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                        <rect x="4" y="10" width="16" height="10" rx="2" stroke="currentColor" stroke-width="1.6"/>
                        <path d="M8 10V7a4 4 0 018 0v3" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/>
                     </svg>
                  </span>
               </div>
            </div>
            <div class="sag-field">
               <label for="tp_repassword">Confirm Password</label>
               <div class="sag-input">
                  <input class="confirm-password" id="tp_repassword" type="password" placeholder="Min. 6 character">
                  <span class="sag-icon">
                     <svg width="18" height="18" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                        <rect x="4" y="10" width="16" height="10" rx="2" stroke="currentColor" stroke-width="1.6"/>
                        <path d="M8 10V7a4 4 0 018 0v3" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/>
                     </svg>
                  </span>
               </div>
            </div>
            <button class="btn-reset">Reset password</button>
            <div class="sag-back">
               Remember your password? <a asp-action="Login" asp-controller="Home">Back to login</a>
            </div>
         </div>
      </div>
   </div>
</div>

@section Scripts {
   <script>
      $(document).ready(function () {
         $('.btn-reset').click(function () {
            let Email = $('.reset-email').val();
            let Token = $('.reset-token').val();
            let NewPassword = $('.new-password').val();
            let ConfirmPassword = $('.confirm-password').val();

            if (!NewPassword || NewPassword.trim() === '') {
               Swal.fire({ title: 'Warning!', text: 'Please enter a new password.', icon: 'warning', confirmButtonText: 'Close' });
               return;
            }

            if (NewPassword.trim() !== ConfirmPassword.trim()) {
               Swal.fire({ title: 'Warning!', text: 'Password and Confirm Password must be the same!', icon: 'warning', confirmButtonText: 'Close' });
               return;
            }

            $.ajax({
               url: window.APP_CONFIG.BASE_URL + window.APP_CONFIG.PATH_RESET_PASSWORD,
               type: 'POST',
               contentType: 'application/json',
               data: JSON.stringify({ Email, Token, NewPassword }),
               success: function (res) {
                  if (res.responseCode == 200) {
                     Swal.fire({ title: 'Success!', text: res.responseMessage, icon: 'success', confirmButtonText: 'OK' })
                        .then(function () { window.location.href = '/Home/Login'; });
                  } else {
                     Swal.fire({ title: 'Warning!', text: res.responseMessage, icon: 'warning', confirmButtonText: 'Close' });
                  }
               },
               error: function (error) {
                  Swal.fire({ title: 'Error!', text: error.message, icon: 'error', confirmButtonText: 'Close' });
               }
            });
         });
      });
   </script>
}
