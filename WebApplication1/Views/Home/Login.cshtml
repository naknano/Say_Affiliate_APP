
<style>
   .sag-auth {
      --sag-accent: #16b979;
      --sag-accent-2: #0e8f5e;
      min-height: 100vh;
      display: flex;
      align-items: center;
      justify-content: center;
      background:
         radial-gradient(1100px 500px at 12% -10%, rgba(22, 185, 121, .18), transparent 60%),
         radial-gradient(900px 500px at 100% 110%, rgba(14, 143, 94, .16), transparent 55%),
         #0b1220;
   }
   /* two-column shell: animated visual on the left, form card on the right */
   .sag-auth .sag-shell {
      width: 100%;
      max-width: 1040px;
      display: grid;
      grid-template-columns: 1.05fr .95fr;
      align-items: stretch;
      gap: 30px;
      padding: 24px;
   }
   .sag-auth .sag-visual {
      position: relative;
      overflow: hidden;
      border-radius: 24px;
      padding: 40px;
      color: #fff;
      display: flex;
      flex-direction: column;
      justify-content: space-between;
      min-height: 540px;
      background:
         radial-gradient(600px 240px at 90% 0%, rgba(22, 185, 121, .35), transparent 60%),
         linear-gradient(160deg, #10324a 0%, #0c2233 60%, #0a1a28 100%);
      border: 1px solid rgba(255, 255, 255, .08);
      box-shadow: 0 30px 70px rgba(0, 0, 0, .4);
   }
   .sag-auth .sag-visual h2 {
      font-size: 30px;
      font-weight: 700;
      line-height: 1.25;
      margin: 0 0 12px;
      color: #fff;
      position: relative;
      z-index: 2;
   }
   .sag-auth .sag-visual p {
      color: #a9c3d1;
      font-size: 15px;
      max-width: 340px;
      position: relative;
      z-index: 2;
   }
   /* animated candlestick chart */
   .sag-auth .sag-chart {
      position: relative;
      z-index: 2;
      display: flex;
      align-items: flex-end;
      gap: 10px;
      height: 170px;
      margin-top: 24px;
   }
   .sag-auth .sag-chart .bar {
      flex: 1;
      border-radius: 6px 6px 3px 3px;
      background: linear-gradient(180deg, var(--sag-accent), rgba(22, 185, 121, .25));
      transform-origin: bottom;
      animation: sagGrow 2.6s ease-in-out infinite;
   }
   .sag-auth .sag-chart .bar.down {
      background: linear-gradient(180deg, #ff7a90, rgba(255, 122, 144, .25));
   }
   .sag-auth .sag-chart .bar:nth-child(1) { height: 45%; animation-delay: 0s; }
   .sag-auth .sag-chart .bar:nth-child(2) { height: 72%; animation-delay: .2s; }
   .sag-auth .sag-chart .bar:nth-child(3) { height: 38%; animation-delay: .4s; }
   .sag-auth .sag-chart .bar:nth-child(4) { height: 88%; animation-delay: .6s; }
   .sag-auth .sag-chart .bar:nth-child(5) { height: 60%; animation-delay: .8s; }
   .sag-auth .sag-chart .bar:nth-child(6) { height: 96%; animation-delay: 1s; }
   .sag-auth .sag-chart .bar:nth-child(7) { height: 52%; animation-delay: 1.2s; }
   .sag-auth .sag-chart .bar:nth-child(8) { height: 78%; animation-delay: 1.4s; }
   @@keyframes sagGrow {
      0%, 100% { transform: scaleY(.72); opacity: .8; }
      50% { transform: scaleY(1); opacity: 1; }
   }
   /* floating stat chips */
   .sag-auth .sag-chip {
      position: absolute;
      z-index: 3;
      background: rgba(255, 255, 255, .1);
      border: 1px solid rgba(255, 255, 255, .18);
      backdrop-filter: blur(6px);
      border-radius: 14px;
      padding: 12px 16px;
      color: #fff;
      font-size: 13px;
      box-shadow: 0 12px 26px rgba(0, 0, 0, .3);
      animation: sagFloat 5s ease-in-out infinite;
   }
   .sag-auth .sag-chip .up { color: var(--sag-accent); font-weight: 700; }
   .sag-auth .sag-chip.one { top: 70px; right: 34px; animation-delay: 0s; }
   .sag-auth .sag-chip.two { top: 220px; right: 48px; animation-delay: 1.5s; }
   @@keyframes sagFloat {
      0%, 100% { transform: translateY(0); }
      50% { transform: translateY(-12px); }
   }
   @@media (prefers-reduced-motion: reduce) {
      .sag-auth .sag-chart .bar,
      .sag-auth .sag-chip { animation: none; }
   }
   .sag-auth .sag-card {
      width: 100%;
      max-width: 460px;
      margin: auto;
      background: rgba(255, 255, 255, .96);
      border: 1px solid rgba(255, 255, 255, .5);
      border-radius: 22px;
      padding: 44px 40px;
      box-shadow: 0 30px 70px rgba(0, 0, 0, .35);
      backdrop-filter: blur(8px);
   }
   .sag-auth .sag-brand {
      width: 62px;
      height: 62px;
      margin: 0 auto 18px;
      border-radius: 16px;
      display: flex;
      align-items: center;
      justify-content: center;
      color: #fff;
      background: linear-gradient(135deg, var(--sag-accent), var(--sag-accent-2));
      box-shadow: 0 10px 24px rgba(22, 185, 121, .4);
   }
   .sag-auth .sag-title {
      font-size: 26px;
      font-weight: 700;
      text-align: center;
      margin-bottom: 6px;
      color: #0b1220;
   }
   .sag-auth .sag-sub {
      text-align: center;
      color: #6b7280;
      font-size: 14px;
      margin-bottom: 30px;
   }
   .sag-auth .sag-sub a { color: var(--sag-accent-2); font-weight: 600; }
   .sag-auth .sag-field { margin-bottom: 20px; }
   .sag-auth .sag-field label {
      display: block;
      font-size: 13px;
      font-weight: 600;
      color: #374151;
      margin-bottom: 8px;
   }
   .sag-auth .sag-input {
      position: relative;
      display: flex;
      align-items: center;
   }
   .sag-auth .sag-input .sag-icon {
      position: absolute;
      left: 16px;
      color: #9ca3af;
      display: flex;
   }
   .sag-auth .sag-input input {
      width: 100%;
      height: 52px;
      padding: 0 46px 0 46px;
      border: 1.5px solid #e5e7eb;
      border-radius: 12px;
      font-size: 15px;
      color: #111827;
      background: #f9fafb;
      transition: border-color .2s, box-shadow .2s, background .2s;
   }
   .sag-auth .sag-input input::placeholder { color: #9ca3af; }
   .sag-auth .sag-input input:focus {
      outline: none;
      background: #fff;
      border-color: var(--sag-accent);
      box-shadow: 0 0 0 4px rgba(22, 185, 121, .15);
   }
   .sag-auth .sag-input input:focus + .sag-icon,
   .sag-auth .sag-input input:focus ~ .sag-icon { color: var(--sag-accent-2); }
   .sag-auth .tp-login-input-eye {
      position: absolute;
      right: 16px;
      cursor: pointer;
      color: #9ca3af;
   }
   .sag-auth .sag-meta {
      display: flex;
      align-items: center;
      justify-content: space-between;
      margin-bottom: 26px;
      font-size: 13px;
   }
   .sag-auth .sag-remember {
      display: flex;
      align-items: center;
      gap: 8px;
      color: #4b5563;
   }
   .sag-auth .sag-remember input { width: 16px; height: 16px; accent-color: var(--sag-accent); }
   .sag-auth .sag-forgot a { color: var(--sag-accent-2); font-weight: 600; }
   .sag-auth .btn-login {
      width: 100%;
      height: 54px;
      border: none;
      border-radius: 12px;
      color: #fff;
      font-size: 16px;
      font-weight: 600;
      cursor: pointer;
      background: linear-gradient(135deg, var(--sag-accent), var(--sag-accent-2));
      box-shadow: 0 12px 26px rgba(22, 185, 121, .38);
      transition: transform .15s ease, box-shadow .2s ease, opacity .2s;
   }
   .sag-auth .btn-login:hover { transform: translateY(-2px); box-shadow: 0 16px 32px rgba(22, 185, 121, .5); }
   .sag-auth .btn-login:active { transform: translateY(0); }
   .sag-auth .btn-login:disabled { opacity: .7; cursor: not-allowed; transform: none; }
   @@media (max-width: 991px) {
      .sag-auth .sag-shell { grid-template-columns: 1fr; max-width: 520px; }
      .sag-auth .sag-visual { display: none; }
   }
   @@media (max-width: 480px) {
      .sag-auth .sag-card { padding: 34px 24px; border-radius: 18px; }
   }
</style>

