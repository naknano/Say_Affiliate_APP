<style>
.str-hero{background:linear-gradient(135deg,#0a0f1e 0%,#0f2040 50%,#05080f 100%);padding:112px 0 48px;position:relative;overflow:hidden;}
.str-hero::before{content:'';position:absolute;inset:0;background:url("data:image/svg+xml,%3Csvg width='60' height='60' viewBox='0 0 60 60' xmlns='http://www.w3.org/2000/svg'%3E%3Cg fill='none' fill-rule='evenodd'%3E%3Cg fill='%23ffffff' fill-opacity='0.03'%3E%3Cpath d='M36 34v-4h-2v4h-4v2h4v4h2v-4h4v-2h-4zm0-30V0h-2v4h-4v2h4v4h2V6h4V4h-4zM6 34v-4H4v4H0v2h4v4h2v-4h4v-2H6zM6 4V0H4v4H0v2h4v4h2V6h4V4H6z'/%3E%3C/g%3E%3C/g%3E%3C/svg%3E");pointer-events:none;}
.str-hero-eyebrow{display:inline-flex;align-items:center;gap:8px;background:rgba(255,255,255,.08);border:1px solid rgba(255,255,255,.15);border-radius:999px;padding:5px 14px;font-size:11px;font-weight:700;color:#93c5fd;letter-spacing:.1em;text-transform:uppercase;margin-bottom:18px;}
.str-hero-title{font-size:clamp(26px,4vw,44px);font-weight:900;color:#fff;line-height:1.15;margin:0 0 14px;}
.str-hero-title span{background:linear-gradient(90deg,#38bdf8,#818cf8);-webkit-background-clip:text;-webkit-text-fill-color:transparent;background-clip:text;}
.str-hero-sub{font-size:15px;color:rgba(255,255,255,.65);line-height:1.7;max-width:520px;}
.str-stats-row{display:flex;flex-wrap:wrap;gap:10px;margin-top:28px;}
.str-stat-chip{display:flex;align-items:center;gap:8px;background:rgba(255,255,255,.07);border:1px solid rgba(255,255,255,.12);border-radius:10px;padding:9px 16px;}
.str-stat-chip-num{font-size:20px;font-weight:900;color:#fff;line-height:1;}
.str-stat-chip-lbl{font-size:11px;color:rgba(255,255,255,.55);font-weight:600;text-transform:uppercase;letter-spacing:.06em;line-height:1.3;}
.str-hero-img{width:100%;max-width:400px;opacity:.9;}

.str-filter-bar{background:#fff;border-bottom:1px solid #e8edf4;padding:0 0 0;position:sticky;top:64px;z-index:80;}
.str-filter-inner{display:flex;align-items:center;gap:6px;padding:14px 0;overflow-x:auto;-webkit-overflow-scrolling:touch;scrollbar-width:none;}
.str-filter-inner::-webkit-scrollbar{display:none;}
.str-filter-btn{flex-shrink:0;padding:7px 18px;border-radius:999px;border:1.5px solid #e2e8f0;background:#fff;font-size:13px;font-weight:600;color:#64748b;cursor:pointer;transition:all .18s;white-space:nowrap;}
.str-filter-btn:hover{border-color:#009AEE;color:#009AEE;}
.str-filter-btn.active{background:#009AEE;border-color:#009AEE;color:#fff;}

.str-cards-header{display:flex;align-items:center;justify-content:space-between;margin-bottom:24px;flex-wrap:wrap;gap:10px;}
.str-cards-count{font-size:14px;color:#64748b;font-weight:500;}
.str-cards-count strong{color:#0f1b2d;font-weight:700;}

.str-pagination{display:flex;align-items:center;justify-content:center;gap:8px;margin-top:36px;padding-top:28px;border-top:1px solid #f1f5f9;}
.str-page-btn{width:40px;height:40px;border-radius:10px;border:1.5px solid #e2e8f0;background:#fff;font-size:14px;font-weight:600;color:#64748b;cursor:pointer;display:flex;align-items:center;justify-content:center;transition:all .18s;}
.str-page-btn:hover{border-color:#009AEE;color:#009AEE;}
.str-page-btn.active{background:#009AEE;border-color:#009AEE;color:#fff;}
.str-page-btn:disabled{opacity:.4;cursor:not-allowed;}
.str-page-info{font-size:13px;color:#64748b;padding:0 8px;}
.str-no-results{text-align:center;padding:48px 24px;color:#94a3b8;font-size:15px;display:none;}
</style>

<div class="res-page">

    <!-- Hero -->
    <section class="str-hero">
        <div class="container container-1230">
            <nav class="res-breadcrumb" style="margin-bottom:20px;">
                <a asp-controller="Home" asp-action="Index"><i class="fa-solid fa-house"></i></a>
                <i class="fa-solid fa-chevron-right"></i>
                <a asp-controller="Resources" asp-action="Index">Forex Resources</a>
                <i class="fa-solid fa-chevron-right"></i>
                <span>Strategies &amp; Technical Analysis</span>
            </nav>
            <div class="row align-items-center g-4">
                <div class="col-lg-7">
                    <div class="str-hero-eyebrow"><i class="fa-solid fa-book-open-reader"></i> Strategy Library</div>
                    <h1 class="str-hero-title">Strategies &amp; <span>Technical Analysis</span></h1>
                    <p class="str-hero-sub">Proven forex trading strategies from beginner to advanced — day trading, swing trading, scalping, algo systems, and everything in between.</p>
                    <div class="str-stats-row">
                        <div class="str-stat-chip"><div class="str-stat-chip-num">12</div><div class="str-stat-chip-lbl">Strategy<br>Guides</div></div>
                        <div class="str-stat-chip"><div class="str-stat-chip-num">3</div><div class="str-stat-chip-lbl">Skill<br>Levels</div></div>
                        <div class="str-stat-chip"><div class="str-stat-chip-num">5</div><div class="str-stat-chip-lbl">Strategy<br>Categories</div></div>
                        <div class="str-stat-chip"><div class="str-stat-chip-num">Free</div><div class="str-stat-chip-lbl">All Content<br>Access</div></div>
                    </div>
                </div>
                <div class="col-lg-5 text-center d-none d-lg-block">
                    <div style="position:relative;display:inline-block;">
                        <div style="width:280px;height:200px;background:rgba(255,255,255,.04);border:1.5px solid rgba(255,255,255,.1);border-radius:20px;padding:20px;display:flex;flex-direction:column;gap:10px;">
                            @foreach(var chip in new[]{new{C="#16a34a",L="Cashback Strategy"},new{C="#ca8a04",L="Market Analysis"},new{C="#ea580c",L="Day Trading"},new{C="#4f46e5",L="Technical Analysis"},new{C="#312e81",L="Advanced Strategies"}})
                            {<div style="display:flex;align-items:center;gap:10px;background:rgba(255,255,255,.06);border-radius:8px;padding:7px 12px;"><div style="width:8px;height:8px;border-radius:50%;background:@chip.C;flex-shrink:0;"></div><span style="font-size:13px;font-weight:600;color:rgba(255,255,255,.8);">@chip.L</span></div>}
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- Filter Bar -->
    <div class="str-filter-bar">
        <div class="container container-1230">
            <div class="str-filter-inner">
                <button class="str-filter-btn active" data-filter="all"><i class="fa-solid fa-border-all me-1"></i> All Guides</button>
                <button class="str-filter-btn" data-filter="cashback"><i class="fa-solid fa-sack-dollar me-1"></i> Cashback</button>
                <button class="str-filter-btn" data-filter="market"><i class="fa-solid fa-chart-area me-1"></i> Market Analysis</button>
                <button class="str-filter-btn" data-filter="style"><i class="fa-solid fa-layer-group me-1"></i> Trading Styles</button>
                <button class="str-filter-btn" data-filter="technical"><i class="fa-solid fa-chart-bar me-1"></i> Technical</button>
                <button class="str-filter-btn" data-filter="advanced"><i class="fa-solid fa-brain me-1"></i> Advanced</button>
            </div>
        </div>
    </div>

    <!-- Main Content -->
    <div class="res-sub-layout">
        <div class="container container-1230">
            <div class="row g-4 align-items-start">

                <div class="col-lg-3 col-md-4">
                    <partial name="_Sidebar" model="@("Strategies")" />
                </div>

                <div class="col-lg-9 col-md-8">

                    <div class="str-cards-header">
                        <div class="str-cards-count">Showing <strong id="str-showing">12</strong> of 12 strategy guides</div>
                        <div style="display:flex;align-items:center;gap:6px;font-size:13px;color:#64748b;"><i class="fa-solid fa-circle-info"></i> Click any guide to read the full article</div>
                    </div>

                    <div id="str-grid" class="row g-4">
                        @foreach (var a in articles)
                        {
                            <div class="col-lg-4 col-sm-6 str-card-col" data-cat="@a.Cat">
                                <a asp-controller="@a.Ctrl" asp-action="@a.Act" class="fn-card" style="position:relative;">
                                    <div class="fn-thumb" style="background:@a.ThumbBg;">
                                        <div class="fn-thumb-text">@Html.Raw(a.ThumbText)</div>
                                        <div class="fn-thumb-badge" style="background:@a.BadgeBg;color:@a.BadgeClr;font-size:9px;">@Html.Raw(a.BadgeTxt.Replace("\n","<br/>"))</div>
                                        <div class="fn-thumb-brand">
                                            <div class="fn-thumb-brand-icon"><i class="fa-solid fa-chart-line" style="font-size:8px;"></i></div>
                                            <span>SAY AFFILIATES</span>
                                        </div>
                                        <div class="str-diff-badge str-diff-@a.Diff.ToLower()">@a.Diff</div>
                                    </div>
                                    <div class="fn-card-body">
                                        <span class="fn-card-author" style="color:@a.AuthorClr;">Say Affiliates</span>
                                        <h3 class="fn-card-title">@a.Title</h3>
                                        <div class="fn-card-date"><i class="fa-regular fa-calendar me-1"></i>@a.Date</div>
                                        <p class="fn-card-excerpt">@a.Excerpt</p>
                                    </div>
                                </a>
                            </div>
                        }
                    </div>

                    <div class="str-no-results" id="str-no-results"><i class="fa-solid fa-magnifying-glass fa-2x mb-3 d-block"></i>No guides in this category yet. Check back soon.</div>

                    <div class="str-pagination" id="str-pagination">
                        <button class="str-page-btn" id="str-prev" disabled><i class="fa-solid fa-chevron-left"></i></button>
                        <span class="str-page-info" id="str-page-info">Page 1 of 2</span>
                        <button class="str-page-btn" id="str-next"><i class="fa-solid fa-chevron-right"></i></button>
                    </div>

                </div>
            </div>
        </div>
    </div>
</div>

<style>
.str-diff-badge{position:absolute;bottom:12px;right:14px;font-size:9px;font-weight:800;padding:2px 8px;border-radius:5px;letter-spacing:.06em;text-transform:uppercase;border:1.5px solid rgba(0,0,0,.1);}
.str-diff-beginner{background:#d1fae5;color:#065f46;}
.str-diff-intermediate{background:#fff7ed;color:#92400e;}
.str-diff-advanced{background:#fee2e2;color:#7f1d1d;}
</style>

@section Scripts {
<script>
$(function(){
    var perPage = 6;
    var currentPage = 1;
    var currentFilter = 'all';

    function getVisible(){
        if(currentFilter==='all') return $('.str-card-col');
        return $('.str-card-col[data-cat="'+currentFilter+'"]');
    }

    function renderPage(){
        var $visible = getVisible();
        var total = $visible.length;
        var pages = Math.ceil(total/perPage) || 1;
        if(currentPage > pages) currentPage = 1;

        $('.str-card-col').hide();

        $visible.each(function(i){
            var start = (currentPage-1)*perPage;
            if(i >= start && i < start+perPage) $(this).show();
        });

        $('#str-showing').text(total);

        if(total===0){ $('#str-no-results').show(); } else { $('#str-no-results').hide(); }

        if(pages<=1){ $('#str-pagination').hide(); } else { $('#str-pagination').show(); }
        $('#str-page-info').text('Page '+currentPage+' of '+pages);
        $('#str-prev').prop('disabled', currentPage<=1);
        $('#str-next').prop('disabled', currentPage>=pages);
    }

    $('.str-filter-btn').on('click', function(){
        $('.str-filter-btn').removeClass('active');
        $(this).addClass('active');
        currentFilter = $(this).data('filter');
        currentPage = 1;
        renderPage();
    });

    $('#str-prev').on('click', function(){
        if(currentPage>1){ currentPage--; renderPage(); $('html,body').animate({scrollTop:$('#str-grid').offset().top-140},240); }
    });
    $('#str-next').on('click', function(){
        var $visible = getVisible();
        var pages = Math.ceil($visible.length/perPage)||1;
        if(currentPage<pages){ currentPage++; renderPage(); $('html,body').animate({scrollTop:$('#str-grid').offset().top-140},240); }
    });

    renderPage();
});
</script>
}
