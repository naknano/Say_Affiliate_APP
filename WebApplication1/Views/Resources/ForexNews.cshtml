<div class="res-page">

    <section class="lfb-hero">
        <div class="container container-1230">
            <nav class="res-breadcrumb" aria-label="breadcrumb">
                <a asp-controller="Home"      asp-action="Index"><i class="fa-solid fa-house"></i></a>
                <i class="fa-solid fa-chevron-right"></i>
                <a asp-controller="Resources" asp-action="Index">Forex Resources</a>
                <i class="fa-solid fa-chevron-right"></i>
                <span>Forex News</span>
            </nav>
            <div class="row align-items-center g-4">
                <div class="col-lg-5">
                    <h1 style="font-size:clamp(30px,4.5vw,46px);font-weight:800;color:#0f1b2d;line-height:1.15;margin:0 0 16px;">Forex News</h1>
                </div>
                <div class="col-lg-7">
                    <p class="lfb-hero-desc">Stay informed on the latest market updates, regulatory changes, and industry insights that can shape your forex trading decisions.</p>
                </div>
            </div>
        </div>
    </section>

    <div class="res-sub-layout">
        <div class="container container-1230">
            <div class="row g-4 align-items-start">

                <div class="col-lg-3 col-md-4">
                    <partial name="_Sidebar" model="@("ForexNews")" />
                </div>

                <div class="col-lg-9 col-md-8">
                    <div class="row g-4">
                        @foreach (var a in articles)
                        {
                            <div class="col-lg-4 col-sm-6">
                                <a asp-controller="@a.Ctrl" asp-action="@a.Act" class="fn-card">
                                    <div class="fn-thumb" style="background:@a.ThumbBg;">
                                        <div class="fn-thumb-text">@Html.Raw(a.ThumbText)</div>
                                        <div class="fn-thumb-badge" style="background:@a.BadgeBg;color:@a.BadgeClr;">@Html.Raw(a.BadgeTxt.Replace("\n","<br/>"))</div>
                                        <div class="fn-thumb-brand">
                                            <div class="fn-thumb-brand-icon"><i class="fa-solid fa-chart-line" style="font-size:8px;"></i></div>
                                            <span>SAY AFFILIATES</span>
                                        </div>
                                    </div>
                                    <div class="fn-card-body">
                                        <span class="fn-card-author" style="color:@a.AuthorClr;">@a.Author</span>
                                        <h3 class="fn-card-title">@a.Title</h3>
                                        <div class="fn-card-date"><i class="fa-regular fa-calendar me-1"></i>Published @a.Date</div>
                                        <p class="fn-card-excerpt">@a.Excerpt</p>
                                    </div>
                                </a>
                            </div>
                        }
                    </div>
                </div>

            </div>
        </div>
    </div>

</div>
