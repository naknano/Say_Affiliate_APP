            BadgeBg  = "#7c3aed", BadgeClr="#fff", BadgeTxt="yahoo!\nfinance",
            AuthorClr= "#7c3aed", Author="Bogdan Ulmu",
            Title    = "Trading Assistance Platform Say Affiliates Introduces Unique Free Tools",
