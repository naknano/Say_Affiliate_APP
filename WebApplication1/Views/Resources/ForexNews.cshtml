            Excerpt  = "See in Real-Time the Pricing and Spreads of 100s of Brokerage Houses."
        },
        new {
            Ctrl="Resources", Act="ForexNewsRevolutionising",
            ThumbBg  = "linear-gradient(135deg,#c2e4dd 0%,#9ecfc5 100%)",
