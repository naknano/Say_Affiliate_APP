        new { Ctrl="Resources", Act="ForexNewsFreePlatform",    Icon="fa-solid fa-gift",         Bg="#f5f3ff", Clr="#7c3aed", Title="Here's a Free Platform That Reinvents Forex Cashback",         Date="16 Mar 2023" },
        new { Ctrl="Resources", Act="ForexNewsUniqueTools",     Icon="fa-solid fa-toolbox",      Bg="#eff6ff", Clr="#2563eb", Title="Say Affiliates Introduces Unique Free Tools",                    Date="16 Mar 2023" },
        new { Ctrl="Resources", Act="ForexNewsRedefining",      Icon="fa-solid fa-star",         Bg="#f0fdf4", Clr="#16a34a", Title="How Say Affiliates Is Redefining The Industry Of Forex Trading", Date="29 Jul 2022" },
    };
