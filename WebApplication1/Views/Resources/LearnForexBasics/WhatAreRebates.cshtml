                <a asp-controller="Home" asp-action="Broker" class="frt-tool-btn"><i class="fa-solid fa-award frt-tool-btn-icon" style="color:#d97706;"></i><span class="frt-tool-btn-label">Compare Brokers</span><i class="fa-solid fa-arrow-right frt-tool-btn-arrow"></i></a>
                <a asp-controller="Home" asp-action="LiveBrokerSpreads" class="frt-tool-btn"><i class="fa-solid fa-arrow-trend-up frt-tool-btn-icon" style="color:#2563eb;"></i><span class="frt-tool-btn-label">Live Broker Spreads</span><i class="fa-solid fa-arrow-right frt-tool-btn-arrow"></i></a>
