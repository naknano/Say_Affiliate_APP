<div class="na-stat-strip"><div class="container container-1230"><div class="row g-0">
    <div class="col-6 col-md-3"><div class="na-stat"><div class="na-stat-num" style="color:@ac;">$7.5T</div><div class="na-stat-lbl">Daily Volume</div></div></div>
