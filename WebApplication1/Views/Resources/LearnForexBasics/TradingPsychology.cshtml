    <div class="container container-1230">
        <nav class="br-hero-breadcrumb">
            <a asp-controller="Home" asp-action="Index"><i class="fa-solid fa-house"></i></a><i class="fa-solid fa-chevron-right"></i>
            <a asp-controller="Resources" asp-action="Index">Resources</a><i class="fa-solid fa-chevron-right"></i>
            <a asp-controller="Resources" asp-action="LearnForexBasics">Learn Forex Basics</a><i class="fa-solid fa-chevron-right"></i>
            <span>Trading Psychology</span>
        </nav>
        <div class="row align-items-center g-4 mt-1">
            <div class="col-lg-8">
                <h1 class="na-headline">Trading Psychology: Mastering Your Mindset for Consistent Profits</h1>
                <div class="na-byline">
                    <span class="na-byline-item"><i class="fa-solid fa-pen-nib"></i> Say Affiliates</span>
                    <span class="na-byline-item"><i class="fa-regular fa-calendar"></i> 14 Mar 2024</span>
                    <span class="na-byline-item"><i class="fa-regular fa-clock"></i> 9 min read</span>
                    <span class="na-byline-item"><i class="fa-solid fa-tag"></i> Mindset</span>
                </div>
            </div>
            <div class="col-lg-4">
                <div class="br-score-card" style="border-color:rgba(8,145,178,.35);">
                    <div style="font-size:11px;font-weight:700;color:#a5f3fc;letter-spacing:.08em;text-transform:uppercase;margin-bottom:14px;text-align:center;"><i class="fa-solid fa-brain me-1"></i> The Mental Game</div>
