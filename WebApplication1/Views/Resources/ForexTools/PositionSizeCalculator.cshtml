                                        <span class="psc-example-input-label">Account Risk</span>
                                        <span class="psc-example-input-val">$100</span>
                                    </div>
                                    <div class="psc-example-input">
                                        <span class="psc-example-input-label">Stop Loss</span>
                                        <span class="psc-example-input-val">$5 / oz</span>
