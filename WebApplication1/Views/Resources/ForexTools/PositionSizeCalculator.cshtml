                                        <span class="psc-formula-bar"></span>
                                        <span class="psc-formula-den">Stop Loss (pips) &times; Pip Value per lot ($)</span>
                                    </span>
                                </div>
                            </div>

                            <h3 class="br-h3">Variable Definitions</h3>
                            <div class="br-fact-grid" style="grid-template-columns:repeat(2,1fr);margin-bottom:20px;">
                                <div class="br-fact-item">
                                    <div class="br-fact-icon" style="background:#eff6ff;color:#2563eb;"><i class="fa-solid fa-wallet"></i></div>
                                    <div>
                                        <div class="br-fact-key">Account Risk ($)</div>
                                        <div class="br-fact-val">Your account balance × risk %. On a $10,000 account risking 1%, Account Risk = $100.</div>
                                    </div>
                                </div>
                                <div class="br-fact-item">
                                    <div class="br-fact-icon" style="background:#f0fdf4;color:#16a34a;"><i class="fa-solid fa-ruler"></i></div>
                                    <div>
                                        <div class="br-fact-key">Stop Loss (pips)</div>
                                        <div class="br-fact-val">Distance from entry to stop-loss in pips. A 20-pip stop on EUR/USD = 0.0020 price movement.</div>
                                    </div>
                                </div>
                                <div class="br-fact-item">
                                    <div class="br-fact-icon" style="background:#fff7ed;color:#ea580c;"><i class="fa-solid fa-coins"></i></div>
                                    <div>
                                        <div class="br-fact-key">Pip Value per Lot</div>
