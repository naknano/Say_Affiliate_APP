@{
    ViewData["Title"] = "Forex Position Size Calculator: Formulas and Examples";

    var faqs = new[]
    {
        new { Q="What is a Forex position size calculator?",
              A="A position size calculator tells you how many lots (or units) to trade on a given position so you risk exactly the amount you set — typically 1–2% of your account. It takes your account balance, risk %, currency pair, and stop-loss distance as inputs and outputs the correct lot size." },
        new { Q="What is the position size formula in Forex?",
              A="Position Size (lots) = Account Risk ($) ÷ (Stop Loss in pips × Pip Value per lot). For a $10,000 account risking 1% ($100) with a 20-pip stop on EUR/USD (pip value $10/lot), position size = $100 ÷ (20 × $10) = 0.5 lots." },
        new { Q="How do I calculate position size on MT4?",
              A="In MT4, right-click the trade ticket and use the built-in calculator, or install a position size EA/indicator. Many traders use the free Forex Position Size Calculator indicator from the MQL4 market — simply input your account risk % and stop-loss pips, and it overlays the lot size directly on the chart." },
        new { Q="What is the pip value for EUR/USD?",
              A="For EUR/USD with a USD-denominated account, the pip value is $10 per standard lot (1.00), $1 per mini lot (0.10), and $0.10 per micro lot (0.01). For cross pairs and accounts in other currencies, the pip value varies and must be converted to your account currency." },
        new { Q="How do I calculate position size for XAU/USD (Gold)?",
              A="Gold has a contract size of 100 oz per standard lot, and prices move in dollars per ounce. One pip on XAU/USD (0.01 price movement) = $1 per standard lot. Use: Position Size = Account Risk ($) ÷ (Stop Loss in USD-per-oz × Contract Size). Most calculators handle Gold automatically when you select XAU/USD." },
        new { Q="Should I use fixed lot or fixed risk percentage?",
              A="Fixed risk percentage (e.g. 1% per trade) is strongly recommended. It scales position size automatically as your account grows or shrinks, preserving your risk consistency. Fixed lot sizing risks proportionally more when your account is smaller and less when it is larger, leading to inconsistent risk exposure over time." },
        new { Q="How does cashback affect my effective risk per trade?",
              A="Cashback rebates reduce your net cost per trade. If you risk $100 and receive $7.50 in cashback per lot, your effective risk drops below $100. On a 0.5-lot EUR/USD trade with a $3.75 rebate, your real risk is $96.25 instead of $100 — improving your risk-reward ratio and reducing the break-even requirement on every trade." },
    };
}

