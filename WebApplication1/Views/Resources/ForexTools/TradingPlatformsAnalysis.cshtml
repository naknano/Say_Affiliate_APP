            Short    = "TradingView",
            Year     = "2011",
            Dev      = "TradingView Inc.",
            Lang     = "Pine Script",
            TF       = "20+ timeframes",
            Ind      = "100+ built-in",
            EA       = "Alerts + Webhook",
            BestFor  = "Analysis, Charting, Multi-asset",
            Icon     = "fa-solid fa-tv",
            Color    = "#7c3aed",
            Bg       = "#f5f3ff",
            Border   = "#ddd6fe",
            Tag      = "Best for Analysis",
            TagBg    = "#7c3aed",
            Desc     = "TradingView is a cloud-based charting and social trading platform launched in 2011, now used by over 50 million traders and investors worldwide. Unlike MT4/MT5, TradingView runs entirely in the browser with no installation required, and is equally powerful on desktop and mobile. Its Pine Script language enables sophisticated custom indicator development with a large open-source community sharing free scripts.",
            Desc2    = "TradingView covers forex, stocks, indices, crypto, commodities, and bonds in a single platform with a clean, modern interface. Its drawing tools are more extensive than MT4/MT5, and the social layer allows traders to share chart ideas and follow top analysts. Direct broker integration is available with a growing number of brokers, enabling order placement from within the chart.",
            Pros     = new[] { "Browser-based — no installation, works on any device", "100+ built-in indicators plus thousands of community scripts", "Beautiful, modern charting with advanced drawing tools", "Social trading layer — share ideas, follow analysts", "Covers all asset classes in one platform", "Pine Script community with millions of free indicators" },
            Cons     = new[] { "Not all brokers support direct TradingView execution", "Automated trading requires third-party webhook tools", "Free tier is limited — full features require paid subscription", "No native EA/robot functionality", "Backtesting is limited compared to MT5 Strategy Tester", "Dependent on internet connection — no offline mode" }
        },
    };
}

