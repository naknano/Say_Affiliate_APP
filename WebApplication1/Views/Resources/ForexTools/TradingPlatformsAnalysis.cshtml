@{
    ViewData["Title"] = "Forex Trading Platforms Analysis: MT4, MT5, and TradingView";

    var faqs = new[]
    {
        new { Q="Is MT4 better than MT5 for forex trading?",
              A="MT4 remains the most popular platform for forex-specific trading, largely due to its massive library of third-party EAs and indicators built in MQL4. MT5 is technically superior — more timeframes, more order types, hedging on more brokers, and a faster backtester — but the MQL4 library advantage keeps MT4 dominant for algorithmic traders. Choose MT5 if you trade multi-asset or want the best backtesting environment." },
        new { Q="Can I use TradingView to trade directly with my broker?",
              A="Yes — TradingView supports direct broker integration with many brokers through its 'Trading Panel'. When your broker supports it, you can place, modify, and close trades directly from TradingView charts. However, not all brokers support this. Check your broker's supported platforms page or look for the 'Trade' button in TradingView's broker connection settings." },
        new { Q="Which platform is best for automated trading (EAs)?",
              A="MT4 and MT5 both support Expert Advisors (EAs) — automated trading robots coded in MQL4 and MQL5 respectively. TradingView supports Pine Script alerts that can trigger trades via third-party automation tools (like 3Commas or Webhook), but it is not a native automated trading platform. For serious algorithmic trading, MT5 with MQL5 is the most powerful option." },
        new { Q="Is TradingView free to use?",
              A="TradingView offers a free tier with limited indicators, alerts, and chart layouts. Paid plans (Essential, Plus, Premium, Ultimate) unlock more indicators per chart, more alerts, replay mode, multiple chart layouts, and priority support. For most retail traders, the free or Essential plan is sufficient for analysis." },
        new { Q="Which platform has the best mobile app?",
              A="TradingView has the most feature-rich and visually polished mobile app, with full charting, drawing tools, and Pine Script indicator support. MetaTrader 4 and MetaTrader 5 mobile apps provide solid trade execution and basic charting but lack the analysis depth of TradingView mobile. Many traders use TradingView mobile for analysis and MT4/MT5 mobile for execution." },
        new { Q="Can I run MT4 on a Mac?",
              A="MT4 and MT5 are primarily Windows applications. On Mac, you can run them via Wine (a Windows compatibility layer), CrossOver, or a virtual machine running Windows. Many brokers also offer a WebTrader (browser-based MT4/MT5) that works natively on Mac and any OS without installation." },
        new { Q="Does my choice of platform affect my cashback rebates?",
              A="Cashback rebates are calculated on lot volume regardless of the platform you use — whether you trade on MT4, MT5, or via a broker integration on TradingView, your rebates are the same per lot. The platform does not affect your rebate rate. However, some platforms (like MT5's advanced backtester) can help you optimise your trading volume and strategy efficiency, indirectly improving your total cashback." },
    };

    var platforms = new[]
    {
