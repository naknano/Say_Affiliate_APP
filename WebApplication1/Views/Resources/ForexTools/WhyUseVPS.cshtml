                                    <div class="br-fact-icon" style="background:#ecfeff;color:#0891b2;"><i class="fa-solid fa-server"></i></div>
                                    <div>
                                        <div class="br-fact-key">What It Is</div>
                                        <div class="br-fact-val">A remote Windows computer hosted in a data centre, always on and connected to the internet.</div>
                                    </div>
                                </div>
                                <div class="br-fact-item">
                                    <div class="br-fact-icon" style="background:#f0fdf4;color:#16a34a;"><i class="fa-solid fa-robot"></i></div>
                                    <div>
                                        <div class="br-fact-key">Primary Use</div>
                                        <div class="br-fact-val">Running MT4/MT5 Expert Advisors 24/7 without requiring your home computer to be switched on.</div>
                                    </div>
                                </div>
                                <div class="br-fact-item">
                                    <div class="br-fact-icon" style="background:#eff6ff;color:#2563eb;"><i class="fa-solid fa-globe"></i></div>
