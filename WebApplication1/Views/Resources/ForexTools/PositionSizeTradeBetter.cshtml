                                                    <span class="ptb-account-row-val" style="color:@a.Color;">@a.Risk2</span>
                                                </div>
                                                <div class="ptb-account-row">
                                                    <span class="ptb-account-row-label">Risk at 2%</span>
                                                    <span class="ptb-account-row-val" style="color:@a.Color;">@a.Risk1</span>
                                                </div>
                                                <div class="ptb-account-row">
