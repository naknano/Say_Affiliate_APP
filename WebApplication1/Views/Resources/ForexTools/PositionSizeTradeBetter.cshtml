@{
    ViewData["Title"] = "Position Size Calculator — Trade Better with Our Free Forex Tools";

    var faqs = new[]
    {
        new { Q="What is the best position size for a beginner trader?",
              A="Beginners should risk no more than 0.5–1% of their account per trade and use micro lots (0.01) to keep losses small while learning. For a $1,000 account, that means risking just $5–$10 per trade — which keeps losses survivable and lets you trade through the learning curve without blowing the account." },
        new { Q="How often should I recalculate my position size?",
              A="Recalculate before every trade. Your account balance changes after every win and loss, meaning the same risk % produces a different dollar amount and therefore a different lot size each time. Never reuse a lot size from a previous trade without recalculating." },
        new { Q="Can I use the same position size for all currency pairs?",
              A="No. Pip value differs between pairs, so the same lot size carries different risk on EUR/USD vs GBP/JPY vs XAU/USD. Always calculate position size specifically for the pair and stop-loss distance on each individual trade." },
        new { Q="How do I handle position sizing when I have multiple trades open?",
              A="Track your total open risk across all positions. If you risk 1% per trade and have 5 trades open simultaneously, your total open risk is 5% of your account — which can be dangerous if markets move against you on correlated pairs. Many professional traders cap total portfolio risk at 5–6%." },
        new { Q="What risk percentage should I use — 1% or 2%?",
              A="Start with 1% while developing your strategy. Move to 1.5–2% only when you have at least 3–6 months of positive trading history with that strategy. Higher risk percentages amplify both gains and drawdowns — a 10-trade losing streak at 2% risk costs 18% of your account vs 10% at 1%." },
        new { Q="Does a tighter stop-loss mean I should use a larger lot size?",
              A="Yes — mathematically it does. A tighter stop means less risk per pip, so you can afford more lots to reach the same dollar risk. However, tighter stops are hit more often by normal market noise. Never set a stop purely to justify a larger lot size — always place stops at technically valid levels first." },
        new { Q="How does cashback rebate improve my position sizing math?",
              A="Cashback rebates reduce your net cost per trade. On a $100 risk trade where you earn $5 in rebates, your true risk is only $95. Over hundreds of trades this adds up significantly — effectively lowering the break-even win rate and improving your edge without changing your strategy at all." },
    };

    var steps = new[]
    {
        new { Num="01", Icon="fa-solid fa-chart-line",         Color="#2563eb", Bg="#eff6ff",
              Title="Check Your Account Balance",
              Body="Open your trading platform and note your current account balance. This is your baseline for all position sizing calculations. Never trade from memory — balances change after every trade." },
        new { Num="02", Icon="fa-solid fa-crosshairs",         Color="#d97706", Bg="#fff7ed",
              Title="Find Your Trade Setup",
              Body="Identify your entry point and the technically valid stop-loss level based on market structure — support/resistance, recent swing high/low, or indicator signal. Do not place your stop to fit a desired lot size." },
        new { Num="03", Icon="fa-solid fa-ruler-horizontal",   Color="#7c3aed", Bg="#f5f3ff",
              Title="Measure Your Stop-Loss in Pips",
              Body="Calculate the distance from your entry price to your stop-loss level in pips. On a 5-digit broker, a move from 1.08500 to 1.08300 is 20 pips. For Gold and indices, measure the distance in price points." },
        new { Num="04", Icon="fa-solid fa-calculator",         Color="#16a34a", Bg="#f0fdf4",
              Title="Run the Position Size Formula",
              Body="Apply: Position Size = Account Risk ($) ÷ (Stop Loss pips × Pip Value per lot). For example: $100 ÷ (20 × $10) = 0.50 lots. Round down to the nearest 0.01 lot to avoid slightly over-risking." },
        new { Num="05", Icon="fa-solid fa-scale-balanced",     Color="#059669", Bg="#ecfdf5",
              Title="Check Total Portfolio Risk",
              Body="Before entering, add this trade's risk to all currently open positions. If your total open risk exceeds 5–6% of your account, consider waiting for an existing trade to close before opening a new one." },
        new { Num="06", Icon="fa-solid fa-circle-play",        Color="#009aee", Bg="#e0f2fe",
              Title="Execute the Trade",
              Body="Enter the lot size into your platform's trade ticket and execute. Your risk is now locked in at the predefined amount regardless of how large or small the market moves." },
    };

    var accounts = new[]
    {
        new { Type="Micro Account",  Balance="$100 – $999",   Risk1="$1–$10",    Risk2="$0.50–$5",  Lot1="0.01–0.10", Lot2="0.01–0.05", Color="#16a34a",  Bg="#f0fdf4",  Border="#bbf7d0",
              Icon="fa-solid fa-seedling", Tag="Best for beginners" },
        new { Type="Mini Account",   Balance="$1,000 – $4,999", Risk1="$10–$50", Risk2="$5–$25",    Lot1="0.10–0.50", Lot2="0.05–0.25", Color="#2563eb",  Bg="#eff6ff",  Border="#bfdbfe",
              Icon="fa-solid fa-chart-bar", Tag="Standard learning size" },
        new { Type="Standard Account",Balance="$5,000 – $24,999",Risk1="$50–$250",Risk2="$25–$125",Lot1="0.50–2.50", Lot2="0.25–1.25", Color="#7c3aed",  Bg="#f5f3ff",  Border="#ddd6fe",
              Icon="fa-solid fa-chart-line", Tag="Serious retail trader" },
        new { Type="Pro Account",    Balance="$25,000+",       Risk1="$250+",     Risk2="$125+",     Lot1="2.50+",     Lot2="1.25+",     Color="#d97706",  Bg="#fff7ed",  Border="#fed7aa",
              Icon="fa-solid fa-rocket", Tag="Experienced / funded" },
    };

    var styles = new[]
    {
        new { Style="Scalper",        Icon="fa-solid fa-bolt",           Color="#ef4444", Bg="#fff5f5", Border="#fecaca",
              SL="5–15 pips",  Risk="0.5–1%",  Trades="10–50/day", Tip="Use micro/mini lots. High trade count means costs add up fast — cashback rebates are critical for scalpers." },
        new { Style="Day Trader",     Icon="fa-solid fa-sun",            Color="#d97706", Bg="#fff7ed", Border="#fed7aa",
              SL="15–50 pips", Risk="1–1.5%",  Trades="1–10/day",  Tip="Recalculate before every trade. Intraday news can widen spreads — factor this into your stop-loss distance." },
        new { Style="Swing Trader",   Icon="fa-solid fa-chart-area",     Color="#2563eb", Bg="#eff6ff", Border="#bfdbfe",
              SL="50–150 pips",Risk="1–2%",    Trades="1–5/week",  Tip="Wider stops mean fewer lots. Overnight swap fees become a real cost — include them in your risk calculation." },
        new { Style="Position Trader",Icon="fa-solid fa-mountain-sun",   Color="#7c3aed", Bg="#f5f3ff", Border="#ddd6fe",
              SL="150+ pips",  Risk="0.5–1%",  Trades="1–4/month", Tip="Use lower risk % to handle large stop-losses. Fundamental events can cause gaps that exceed your stop-loss distance." },
    };
}

