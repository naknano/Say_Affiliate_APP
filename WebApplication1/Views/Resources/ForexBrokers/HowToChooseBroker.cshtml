                                <a asp-controller="Resources" asp-action="ForexBrokers" class="br-cta-btn-ghost"><i class="fa-solid fa-building-columns"></i> Compare All Brokers</a>
                            </div>
                        </div>

                    </div>
                </div>
            </div>
        </div>
    </div>

</div>
