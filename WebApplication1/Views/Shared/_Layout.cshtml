        <!-- Sayaffillates footer part -->
        <style>
        /* ── Footer – dark redesign (matches home sections) ─────── */
        .sag-footer { position:relative; overflow:hidden; background:#05060d; color:#fff; }

        /* CTA banner */
        .sag-ft-banner { position:relative; overflow:hidden; padding:64px 0; background:radial-gradient(120% 160% at 50% 0%,#12193f 0%,#0a0e22 60%,#070912 100%); border-bottom:1px solid rgba(255,255,255,.06); }
        .sag-ft-banner::before { content:''; position:absolute; right:-80px; top:-100px; width:340px; height:340px; border-radius:50%; background:rgba(108,92,231,.35); filter:blur(90px); pointer-events:none; }
        .sag-ft-banner::after  { content:''; position:absolute; left:-80px; bottom:-120px; width:320px; height:320px; border-radius:50%; background:rgba(6,214,160,.3); filter:blur(90px); pointer-events:none; }
        .sag-ft-banner .container { position:relative; z-index:1; }
        .sag-ft-banner-label   { display:inline-flex; align-items:center; gap:6px; font-size:12px; font-weight:700; color:#ffe08a; letter-spacing:.06em; text-transform:uppercase; margin-bottom:14px; padding:7px 16px; border-radius:999px; background:rgba(255,224,138,.12); border:1px solid rgba(255,224,138,.35); }
        .sag-ft-banner-title   { font-size:clamp(24px,3.5vw,38px); font-weight:800; color:#fff; line-height:1.15; margin:0 0 10px; }
        .sag-ft-banner-sub     { font-size:16px; color:rgba(255,255,255,.7); margin:0; }
        .sag-ft-banner-btns    { display:flex; gap:14px; flex-wrap:wrap; }
        .sag-ft-banner-btn-a   { display:inline-flex; align-items:center; gap:8px; background:linear-gradient(90deg,#ffd166,#06d6a0); color:#05060d; font-size:15px; font-weight:800; padding:14px 28px; border-radius:12px; text-decoration:none; transition:transform .25s, box-shadow .25s; box-shadow:0 12px 30px rgba(6,214,160,.35); }
        .sag-ft-banner-btn-a:hover { transform:translateY(-3px); box-shadow:0 18px 44px rgba(6,214,160,.5); color:#05060d; text-decoration:none; }
        .sag-ft-banner-btn-b   { display:inline-flex; align-items:center; gap:8px; background:rgba(255,255,255,.06); border:1px solid rgba(255,255,255,.2); color:#fff; font-size:15px; font-weight:700; padding:14px 28px; border-radius:12px; text-decoration:none; transition:background .25s,transform .25s; }
        .sag-ft-banner-btn-b:hover { background:rgba(255,255,255,.14); transform:translateY(-3px); color:#fff; text-decoration:none; }

        /* Stats strip */
        .sag-ft-stats-strip { background:rgba(255,255,255,.02); border-bottom:1px solid rgba(255,255,255,.06); }
        .sag-ft-stats-inner { display:flex; flex-wrap:wrap; }
        .sag-ft-stat-item   { flex:1; min-width:140px; padding:26px 28px; border-right:1px solid rgba(255,255,255,.06); display:flex; align-items:center; gap:14px; }
        .sag-ft-stat-item:last-child { border-right:none; }
        .sag-ft-stat-icon   { width:46px; height:46px; border-radius:13px; display:flex; align-items:center; justify-content:center; font-size:18px; flex-shrink:0; color:#fff !important; }
        .sag-ft-stat-item:nth-child(1) .sag-ft-stat-icon { background:linear-gradient(135deg,#6c5ce7,#4834b4) !important; }
        .sag-ft-stat-item:nth-child(2) .sag-ft-stat-icon { background:linear-gradient(135deg,#06d6a0,#048c6a) !important; }
        .sag-ft-stat-item:nth-child(3) .sag-ft-stat-icon { background:linear-gradient(135deg,#00b8d9,#0891b2) !important; }
        .sag-ft-stat-item:nth-child(4) .sag-ft-stat-icon { background:linear-gradient(135deg,#ffd166,#f0a500) !important; }
        .sag-ft-stat-num    { font-size:22px; font-weight:800; color:#fff; line-height:1; }
        .sag-ft-stat-lbl    { font-size:11px; color:rgba(255,255,255,.55); font-weight:600; text-transform:uppercase; letter-spacing:.05em; margin-top:3px; }

        /* Main body */
        .sag-ft-body        { padding:60px 0 50px; border-bottom:1px solid rgba(255,255,255,.06); }
        .sag-ft-tagline     { font-size:14px; color:rgba(255,255,255,.65); line-height:1.75; margin:16px 0 22px; max-width:300px; }
        .sag-ft-reg-btn     { display:inline-flex; align-items:center; gap:8px; background:linear-gradient(90deg,#ffd166,#06d6a0); color:#05060d; font-size:14px; font-weight:800; padding:12px 24px; border-radius:10px; text-decoration:none; box-shadow:0 10px 26px rgba(6,214,160,.35); transition:box-shadow .25s,transform .25s; }
        .sag-ft-reg-btn:hover { box-shadow:0 16px 36px rgba(6,214,160,.5); transform:translateY(-2px); color:#05060d; text-decoration:none; }
        .sag-ft-social      { display:flex; gap:10px; margin-top:22px; }
